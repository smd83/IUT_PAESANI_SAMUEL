<Window x:Class="IUT_Paesani_Samuel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IUT_Paesani_Samuel"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            
            <RowDefinition/>
            <RowDefinition Height="50"/>
           

        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            
            <ColumnDefinition/>
            <ColumnDefinition />
            
        </Grid.ColumnDefinitions>
        <GroupBox x:Name="Réception" Header="Réception" Grid.Column="1" Grid.Row="0" Margin="10">
            <TextBox x:Name="textBoxRéception" TextWrapping="Wrap"   IsReadOnly="True" KeyUp="textBoxRéception_KeyUp"/>
        </GroupBox>
        <GroupBox x:Name="Emission" Header="Emission" Grid.Row="0" Grid.Column="0" Margin="10">            
            <TextBox x:Name="textBoxEmission" TextWrapping="Wrap"    IsTabStop="False" AcceptsReturn="True" TextChanged="textBoxEmission_TextChanged" />
        </GroupBox>
        <Button x:Name="buttonEnvoyer" Grid.Column="0" Content="Envoyer" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Height="30"  Width="100" Click="buttonEnvoyer_Click" KeyUp="buttonEnvoyer_KeyUp"/>
        <Button x:Name="buttonTest" Grid.Column="0" Content="Test" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Height="30"  Width="100" Click="buttonEnvoyer_Click" KeyUp="buttonEnvoyer_KeyUp"/>
        <Button x:Name="buttonClear" Grid.Column="0" Content="Clear" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Height="30"  Width="100" Click="buttonEnvoyer_Click" KeyUp="buttonEnvoyer_KeyUp"/>

    </Grid>
</Window>
